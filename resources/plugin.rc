IDD_PLEX_VIEW DIALOGEX 0, 0, 420, 240
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_PAGE_TITLE, 10, 10, 100, 16, SS_ENDELLIPSIS
    LTEXT "Musikbibliothek", IDC_LIBRARY_LABEL, 10, 10, 80, 12
    LTEXT "", IDC_LIBRARY_NAME, 95, 10, 120, 12, SS_ENDELLIPSIS
    COMBOBOX IDC_LIBRARY, 115, 8, 120, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Einstellungen...", IDC_LOGIN, 314, 8, 96, 18, WS_TABSTOP
    PUSHBUTTON "Zurück", IDC_BACK, 10, 36, 52, 18, WS_TABSTOP
    LTEXT "Suche", IDC_SEARCH_LABEL, 70, 39, 32, 12
    EDITTEXT IDC_SEARCH, 105, 36, 140, 18, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "Aktualisieren", IDC_REFRESH, 254, 36, 80, 18, WS_TABSTOP
    PUSHBUTTON "Cache leeren", IDC_CLEAR_CACHE, 340, 36, 70, 18, WS_TABSTOP
    PUSHBUTTON "Filter / Ansichten...", IDC_FILTERS, 254, 56, 100, 18, WS_TABSTOP
    PUSHBUTTON "×", IDC_RESET_SELECTION, 245, 36, 18, 18, WS_TABSTOP
    CONTROL "", IDC_PRIMARY_SELECTION, "SysListView32", LVS_REPORT | LVS_OWNERDATA | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 10, 64, 190, 60
    CONTROL "", IDC_ALBUM_SELECTION, "SysListView32", LVS_REPORT | LVS_OWNERDATA | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 210, 64, 200, 60
    PUSHBUTTON "<", IDC_PRIMARY_PREVIOUS, 10, 125, 20, 15, WS_TABSTOP
    LTEXT "", IDC_PRIMARY_COUNT, 32, 127, 145, 12, SS_CENTER | SS_ENDELLIPSIS
    PUSHBUTTON ">", IDC_PRIMARY_NEXT, 180, 125, 20, 15, WS_TABSTOP
    PUSHBUTTON "<", IDC_ALBUM_PREVIOUS, 210, 125, 20, 15, WS_TABSTOP
    LTEXT "", IDC_ALBUM_COUNT, 232, 127, 145, 12, SS_CENTER | SS_ENDELLIPSIS
    PUSHBUTTON ">", IDC_ALBUM_NEXT, 390, 125, 20, 15, WS_TABSTOP
    CONTROL "", IDC_SPLIT_VERTICAL, "STATIC", SS_NOTIFY | WS_TABSTOP, 202, 64, 6, 76
    CONTROL "", IDC_SPLIT_HORIZONTAL, "STATIC", SS_NOTIFY | WS_TABSTOP, 10, 142, 400, 5
    CONTROL "", IDC_CATALOG, "SysListView32", LVS_REPORT | LVS_OWNERDATA | LVS_SHOWSELALWAYS | LVS_SHAREIMAGELISTS | WS_BORDER | WS_TABSTOP, 10, 64, 400, 120
    LTEXT "", IDC_STATUS, 10, 187, 400, 12
    PUSHBUTTON "Vorherige Seite", IDC_PREVIOUS, 220, 204, 92, 18, WS_TABSTOP
    PUSHBUTTON "Nächste Seite", IDC_NEXT, 318, 204, 92, 18, WS_TABSTOP
END

IDD_PLEX_FILTERS DIALOGEX 0, 0, 360, 188
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Gespeicherte Ansicht", IDC_SAVED_LABEL, 10, 10, 330, 12
    COMBOBOX IDC_SAVED_SEARCH, 10, 25, 180, 150, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Speichern", IDC_SAVE_SEARCH, 198, 25, 72, 16, WS_TABSTOP
    PUSHBUTTON "Löschen", IDC_DELETE_SEARCH, 278, 25, 72, 16, WS_TABSTOP
    LTEXT "Genre", IDC_GENRE_LABEL, 10, 57, 72, 12
    COMBOBOX IDC_GENRE, 88, 54, 262, 130, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Jahr", IDC_YEAR_LABEL, 10, 83, 72, 12
    COMBOBOX IDC_YEAR, 88, 80, 262, 130, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Audioformat", IDC_CODEC_LABEL, 10, 109, 72, 12
    COMBOBOX IDC_CODEC, 88, 106, 262, 130, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "", IDC_STATUS, 10, 132, 340, 24
    PUSHBUTTON "Zurücksetzen", IDC_RESET_FILTERS, 10, 162, 90, 16, WS_TABSTOP
    DEFPUSHBUTTON "Anwenden", IDOK, 174, 162, 84, 16, WS_TABSTOP
    PUSHBUTTON "Abbrechen", IDCANCEL, 266, 162, 84, 16, WS_TABSTOP
END

IDD_PLEX_LOGIN DIALOGEX 0, 0, 360, 288
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_STATUS, 10, 12, 220, 24
    PUSHBUTTON "Mit Plex anmelden...", IDC_LOGIN_REAUTH, 240, 8, 110, 20, WS_TABSTOP
    LTEXT "Server", IDC_LOGIN_SERVER_LABEL, 10, 34, 340, 12
    COMBOBOX IDC_LOGIN_SERVER, 10, 48, 220, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Verbindung testen", IDC_LOGIN_CONNECT, 240, 47, 110, 20, WS_TABSTOP
    LTEXT "Musikbibliothek", IDC_LOGIN_LIBRARY_LABEL, 10, 68, 340, 12
    COMBOBOX IDC_LOGIN_LIBRARY, 10, 82, 340, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Erweitert...", IDC_LOGIN_ADVANCED, 10, 106, 156, 18, WS_TABSTOP
    LTEXT "Verbindung", IDC_LOGIN_CONNECTION_LABEL, 10, 134, 340, 12
    COMBOBOX IDC_LOGIN_CONNECTION, 10, 148, 340, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Serveradresse", IDC_LOGIN_ADDRESS_LABEL, 10, 170, 340, 12
    EDITTEXT IDC_LOGIN_ADDRESS, 10, 184, 340, 18, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Metadaten- und Cover-Cache", IDC_LOGIN_CACHE_LABEL, 10, 212, 340, 12
    COMBOBOX IDC_LOGIN_CACHE, 10, 226, 220, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Cache leeren", IDC_LOGIN_CLEAR_CACHE, 240, 225, 110, 20, WS_TABSTOP
    PUSHBUTTON "Diagnose...", IDC_LOGIN_DIAGNOSTICS, 10, 258, 110, 20, WS_TABSTOP
    DEFPUSHBUTTON "Speichern", IDOK, 182, 258, 80, 20, WS_TABSTOP
    PUSHBUTTON "Abbrechen", IDCANCEL, 270, 258, 80, 20, WS_TABSTOP
END

