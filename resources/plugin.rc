#include <windows.h>
#include <commctrl.h>
#include "resource.h"
#pragma code_page(65001)

IDD_PLEX_VIEW DIALOGEX 0, 0, 420, 240
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Künstler", IDC_PAGE_TITLE, 10, 10, 100, 16, SS_ENDELLIPSIS
    COMBOBOX IDC_LIBRARY, 115, 8, 120, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX IDC_LANGUAGE, 240, 8, 68, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Einstellungen...", IDC_LOGIN, 314, 8, 96, 18, WS_TABSTOP
    PUSHBUTTON "Zurück", IDC_BACK, 10, 36, 52, 18, WS_TABSTOP
    LTEXT "Suche", IDC_SEARCH_LABEL, 70, 39, 32, 12
    EDITTEXT IDC_SEARCH, 105, 36, 140, 18, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "Aktualisieren", IDC_REFRESH, 254, 36, 80, 18, WS_TABSTOP
    PUSHBUTTON "Cache leeren", IDC_CLEAR_CACHE, 340, 36, 70, 18, WS_TABSTOP
    CONTROL "", IDC_CATALOG, "SysListView32", LVS_REPORT | LVS_OWNERDATA | LVS_SHOWSELALWAYS | LVS_SHAREIMAGELISTS | WS_BORDER | WS_TABSTOP, 10, 64, 400, 120
    LTEXT "", IDC_STATUS, 10, 187, 400, 12
    PUSHBUTTON "Vorherige", IDC_PREVIOUS, 280, 204, 60, 18, WS_TABSTOP
    PUSHBUTTON "Nächste", IDC_NEXT, 345, 204, 65, 18, WS_TABSTOP
    PUSHBUTTON "", IDC_TEST_PLAYBACK, 0, 0, 1, 1, NOT WS_VISIBLE
END

IDD_PLEX_LOGIN DIALOGEX 0, 0, 380, 242
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Mit Plex anmelden"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_STATUS, 10, 12, 360, 36
    LTEXT "Server", IDC_LOGIN_SERVER_LABEL, 10, 56, 360, 12
    COMBOBOX IDC_LOGIN_SERVER, 10, 72, 360, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Verbindung", IDC_LOGIN_CONNECTION_LABEL, 10, 102, 248, 12
    COMBOBOX IDC_LOGIN_CONNECTION, 10, 118, 248, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Verbinden", IDC_LOGIN_CONNECT, 268, 117, 102, 18, WS_TABSTOP
    LTEXT "Musikbibliothek", IDC_LOGIN_LIBRARY_LABEL, 10, 148, 360, 12
    COMBOBOX IDC_LOGIN_LIBRARY, 10, 164, 360, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Speichern", IDOK, 184, 212, 90, 20, WS_TABSTOP
    PUSHBUTTON "Abbrechen", IDCANCEL, 282, 212, 88, 20, WS_TABSTOP
END

IDD_PLAYBACK_TEST DIALOGEX 0, 0, 368, 256
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Wiedergabetest"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Serveradresse (HTTPS)", IDC_SERVER_LABEL, 10, 12, 348, 12
    EDITTEXT IDC_SERVER, 10, 27, 348, 16, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Plex-Token", IDC_TOKEN_LABEL, 10, 51, 348, 12
    EDITTEXT IDC_TOKEN, 10, 66, 348, 16, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Medienpfad (/library/parts/...)", IDC_MEDIA_LABEL, 10, 90, 348, 12
    EDITTEXT IDC_MEDIA_PATH, 10, 105, 348, 16, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Titel", IDC_TITLE_LABEL, 10, 129, 230, 12
    EDITTEXT IDC_TRACK_TITLE, 10, 144, 230, 16, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Laufzeit (Sekunden)", IDC_DURATION_LABEL, 250, 129, 108, 12
    EDITTEXT IDC_DURATION, 250, 144, 108, 16, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "", IDC_RESULT, 10, 172, 348, 40
    DEFPUSHBUTTON "Jetzt abspielen", IDOK, 158, 225, 110, 20, WS_TABSTOP
    PUSHBUTTON "Abbrechen", IDCANCEL, 276, 225, 82, 20, WS_TABSTOP
END

1 VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "Winamp Plex Library (Phase 1)\0"
   VALUE "FileVersion", "0.1.0\0"
   VALUE "InternalName", "ml_plex\0"
   VALUE "OriginalFilename", "ml_plex.dll\0"
   VALUE "ProductName", "Winamp Plex Library\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
